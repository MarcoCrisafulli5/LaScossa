{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(ninja:*)",
      "Bash(g++:*)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run dev)",
      "Bash(node server/test/e2e.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(third_party/**)",
      "Edit(dati/partite/**)"
    ]
  }
}
